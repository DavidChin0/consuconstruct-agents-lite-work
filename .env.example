# Credenciales de correo para mail_bus.py (postales a cada agente).
# NUNCA committear a este repo. Solo indicar el modelo; cada PC llena este
# archivo o sus variables de entorno reales.
# 1) Copia: cp .env.example .env
# 2) Rellena con sus propias credenciales (IMAP/SMTP de la PC que corre el agente)

# IMAP (para leer tareas y reportes)
MAIL_IMAP_HOST=imap.servidor.com
MAIL_IMAP_USER=agent_devops@tusdomina.com
MAIL_IMAP_PASS=***********

# SMTP (para enviar reportes y verdicts)
MAIL_SMTP_HOST=smtp.servidor.com
MAIL_SMTP_USER=agent_devops@tusdomina.com
MAIL_SMTP_PASS=*********
MAIL_SMTP_PORT=587
MAIL_IMAP_PORT=993

# Opcional: servidor de notas del agente
NOTES_VAULT_DIR=/c/Users/User/consuconstruct-agents-lite-work/obsidian-vault

# Postgres (solo si usan RAG local; brain.* de ConsuConstruct NO se incluyen)
# DATABASE_URL=postgresql://user:***@localhost:5432/brain_control_lite
